{
    "name": "@pokedb2/pokemon-data",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./artifacts/paldea-db.js",
    "types": "./src/schema.ts",
    "exports": {
        ".": {
            "types": "./src/schema.ts",
            "default": "./artifacts/paldea-db.js"
        }
    },
    "files": [
        "src/schema.ts",
        "artifacts"
    ],
    "scripts": {
        "build": "node --strip-types src/main.ts",
        "lint": "tsc --noEmit",
        "test": "node -e \"process.exit(0)\"",
        "run-sql": "npm --prefix ../db run build && npm --prefix ../db exec -- pokedb2-db-sql",
        "build-pokemon-db": "npm run build"
    },
    "dependencies": {
        "@pokedb2/db": "*",
        "@pokedb2/query-builder": "*"
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "typescript": "^7.0.1-rc"
    }
}
