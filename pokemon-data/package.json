{
    "name": "@project-dragalge/pokemon-data",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./artifacts/paldea-db.js",
    "types": "./src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./artifacts/paldea-db.js"
        },
        "./assets-dir": "./src/assets.js",
        "./assets/*": "./artifacts/assets/*",
        "./icon-slug": {
            "types": "./src/icon-slug.d.ts",
            "default": "./src/icon-slug.js"
        }
    },
    "files": [
        "src/schema.ts",
        "src/index.d.ts",
        "src/assets.js",
        "src/icon-slug.js",
        "src/icon-slug.d.ts",
        "artifacts"
    ],
    "scripts": {
        "build": "node --use-system-ca --strip-types src/main.ts",
        "sync-bulbapedia-locations": "node --use-system-ca --strip-types scripts/sync-bulbapedia-locations.ts",
        "lint": "tsc --noEmit",
        "test": "node -e \"process.exit(0)\"",
        "run-sql": "npm --prefix ../db run build && npm --prefix ../db exec -- project-dragalge-db-sql",
        "build-pokemon-db": "npm run build",
        "dump": "node --strip-types scripts/dump-db.ts"
    },
    "dependencies": {
        "@project-dragalge/db": "*",
        "@project-dragalge/query-builder": "*",
        "playwright-core": "^1.62.1"
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "typescript": "7.1.0-beta"
    }
}
