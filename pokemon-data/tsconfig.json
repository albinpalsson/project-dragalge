{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node"],
        "allowImportingTsExtensions": true
    },
    "include": ["src"]
}
