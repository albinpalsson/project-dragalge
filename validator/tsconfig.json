{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "rewriteRelativeImportExtensions": true,
        "types": ["node"]
    },
    "include": ["src"]
}
